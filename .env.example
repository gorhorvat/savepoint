# Copy to .env and fill in what you want to enable. Everything is optional:
# the app runs on sample data, live PC prices and the built-in recommender
# without any of these.

# AI assistant. Two free options:
# 1. Gemini: a free API key from https://aistudio.google.com (no card needed).
#    Used automatically when set. Tries gemini-3.5-flash, then 3.5-flash-lite,
#    then 3.1-flash-lite if one is busy; GEMINI_MODEL pins a single model.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# 2. A local model with Ollama (https://ollama.com), used when no Gemini key is
#    set. ASSISTANT_PROVIDER=ollama forces it even with a key.
# Download the model first:  ollama pull qwen3:14b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
# Context window in tokens. 8192 fits a 14B model on a 12 GB graphics card.
OLLAMA_NUM_CTX=8192

# Steam library import. Key from https://steamcommunity.com/dev/apikey
# Your Steam profile's "Game details" must be public.
STEAM_API_KEY=

# PlayStation library import. Sign in at https://www.playstation.com, then open
# https://ca.account.sony.com/api/v1/ssocookie and copy the "npsso" value.
PSN_NPSSO=

API_PORT=8787

# Lowest key-shop prices (G2A, Eneba, Kinguin, ...). Free key: https://gg.deals/api/
GGDEALS_API_KEY=

# IGDB game info: genres, release dates, covers and screenshots for every
# platform. Register an app at https://dev.twitch.tv/console (Twitch account
# with two-factor login), then copy its Client ID and a new Client Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# OpenCritic critic scores. Subscribe to the free "OpenCritic API" plan on
# https://rapidapi.com and copy your X-RapidAPI-Key (25 searches a day).
OPENCRITIC_RAPIDAPI_KEY=

# IsThereAnyDeal: best PC deal across official stores and the all-time low.
# API key from https://isthereanydeal.com/apps/my
ITAD_API_KEY=

# Price alerts on your phone through the free ntfy app (https://ntfy.sh).
# Pick a long random topic name and subscribe to it in the app; anyone who
# knows the name can read its messages.
NTFY_TOPIC=

# Login and storage: you sign in with your VerBuddy account (only its SuperAdmin gets in),
# and your library is saved in VerBuddy's database.
# VERBUDDY_API_URL is VerBuddy's backend (the App Service), no trailing slash.
VERBUDDY_API_URL=
# Signs the login cookie. Optional locally (generated into data/session-secret
# when empty); required on Vercel. Any long random string.
SESSION_SECRET=

# --- Vercel only (leave empty locally) ---
# Protects /api/cron/alerts, the daily price-alert check run by Vercel Cron.
# Any long random string; Vercel sends it with each cron call.
CRON_SECRET=
# Upstash Redis for the server caches (HowLongToBeat, OpenCritic, IGDB,
# IsThereAnyDeal, Discover, price alerts). Added automatically when you
# connect an Upstash database to the Vercel project. Locally, .cache/ is used.
KV_REST_API_URL=
KV_REST_API_TOKEN=
