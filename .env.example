# Copy to .env and fill in. Set the same values on Vercel (Project Settings,
# Environment Variables), plus the "Vercel only" ones at the bottom.

# Postgres database on Neon (https://neon.com), free plan. In the Neon console
# open Connect and copy the pooled connection string (host contains -pooler).
DATABASE_URL=

# Signs logins and encrypts each account's PlayStation and Xbox connections.
# Any long random string. Use the same value locally and on Vercel; changing it
# logs everyone out and they connect PlayStation and Xbox again.
SESSION_SECRET=

# AI assistant: a free Gemini API key from https://aistudio.google.com.
GEMINI_API_KEY=

# Steam library, achievements and wishlist for each account's connected Steam.
# Key from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# IGDB game info: genres, release dates, covers and screenshots for every
# platform. Register an app at https://dev.twitch.tv/console (Twitch account
# with two-factor login), then copy its Client ID and a new Client Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Lowest key-shop prices (G2A, Eneba, Kinguin, ...). Free key: https://gg.deals/api/
GGDEALS_API_KEY=

# IsThereAnyDeal: best PC deal across official stores and the all-time low.
# API key from https://isthereanydeal.com/apps/my
ITAD_API_KEY=

# OpenCritic critic scores. Subscribe to the free "OpenCritic API" plan on
# https://rapidapi.com and copy your X-RapidAPI-Key (25 searches a day).
OPENCRITIC_RAPIDAPI_KEY=

# --- Vercel only (leave empty locally) ---
# Protects /api/cron/alerts, the daily price-alert check run by Vercel Cron.
# Any long random string; Vercel sends it with each cron call.
CRON_SECRET=
# Upstash Redis for the server caches. Added automatically when you connect an
# Upstash database to the Vercel project. Locally, .cache/ is used instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
